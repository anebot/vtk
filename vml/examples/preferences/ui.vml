# Compile with: v run vml vml/examples/preferences/ui.vml
Window title="VML preferences" width=54 height=18 dismissable {
	VBox expand {
		Group title=Desktop {
			Grid {
				Label text=Theme;
				Combo $theme col=1 value={theme_index(app.theme)} {
					Item text=Borland;
					Item text="Light Borland";
					Item text=Dark;
					Item text=Light;
					Item text=Teal;
					Item text=Modern;
					Item text=Serial;
					Item text=wineight;
				}
				Label text="Virtual desktops" row=1;
				Spin $desktops col=1 row=1 low=1 high=4 value={app.get_desktop_count()};
			}
		}
		Group title="Mouse cursor" {
			Radio $cursor value={int(app.mouse_cursor.enabled)} {
				Item text="Terminal pointer";
				Item text="Block cursor";
			}
		}
		CheckBox $gradient text="Gradient window titles" checked={app.title_gradient};
		Label $status text="Changes apply to this session.";
		ButtonBar {
			Button text=Defaults changed={fn [mut theme, mut desktops, mut cursor, mut gradient, mut status] (mut _ vtk.Ctl, mut app vtk.App) {
				theme.set_value(0)
				desktops.set_value(1)
				cursor.set_value(0)
				gradient.set_value(0)
				status.set_text('Defaults selected; press Apply.')
				app.set_focus(theme)
			}};
			Button text=Apply changed={fn [theme, desktops, cursor, gradient, mut status] (mut _ vtk.Ctl, mut app vtk.App) {
				app.theme = vtk.theme_preset(theme_presets[theme.value])
				app.set_desktop_count(desktops.value)
				app.set_mouse_cursor(vtk.MouseCursor{ enabled: cursor.value == 1 })
				app.title_gradient = gradient.value != 0
				status.set_text('Preferences applied to this session.')
				app.notify('Preferences applied', 2000)
			}};
		}
	}
	-{
		app.layout()
		app.set_focus(theme)
	}-
}
